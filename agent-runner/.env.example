# Cloud isolated browser (recommended) - live WebRTC embedded in Screen share.
# Get a key at https://app.steel.dev
# Uses session debugUrl for real-time view (not screenshot polling).
STEEL_API_KEY=

# Optional - self-hosted browser instead of cloud (only used when STEEL_API_KEY is unset).
# STEEL_BASE_URL=http://localhost:3000

# Anti-bot (cloud only). On by default so search engines don't CAPTCHA the agent.
# Set to 0 to disable and save credits if your plan doesn't include them.
# HANDY_STEEL_USE_PROXY=1
# HANDY_STEEL_SOLVE_CAPTCHA=1

# Optional - LLM research planner / "why it matters" notes.
# Without a key, Handy uses a local heuristic planner.
#
# Anthropic (preferred if set):
# ANTHROPIC_API_KEY=sk-ant-...
# HANDY_LLM_PROVIDER=anthropic
# HANDY_LLM_MODEL=claude-sonnet-4-5
#
# Or OpenAI-compatible:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# HANDY_LLM_MODEL=gpt-4o-mini

# PNG / non-live dwell time (ms). Live WebRTC ignores this and uses settle/dwell below.
# HANDY_AGENT_PACE_MS=2800

# Live WebRTC pacing (ms) - keep low for real-time Screen share.
# HANDY_LIVE_SETTLE_MS=180
# HANDY_LIVE_DWELL_MS=320

# Force mock slideshow (no real browser)
# HANDY_FORCE_MOCK=1
